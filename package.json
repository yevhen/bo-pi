{
  "name": "@yevhen.b/bo-pi",
  "version": "0.0.9",
  "description": "Umbrella Pi package bundling preflight, Pi Assistant, and macOS theme sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yevhen/bo-pi.git"
  },
  "bugs": "https://github.com/yevhen/bo-pi/issues",
  "homepage": "https://github.com/yevhen/bo-pi#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "preflight",
    "pi-assistant",
    "macos-theme",
    "theme-sync"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./preflight/index.ts",
      "./pi-assistant/index.ts",
      "./macos-theme-sync/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "files": [
    "preflight",
    "pi-assistant",
    "macos-theme-sync",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE",
    "package.json"
  ]
